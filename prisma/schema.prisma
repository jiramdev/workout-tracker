generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  name         String?
  heightCm     Float?
  age          Int?
  sex           String?
  restMessageId String?
  createdAt     DateTime        @default(now())

  workoutPlans WorkoutPlan[]
  exercises    Exercise[]
  schedule     WeeklySchedule?
  workoutLogs  WorkoutLog[]
  weightLogs    BodyWeightLog[]
  notifications AppNotification[]
  pushSubscriptions PushSubscription[]
}

model WorkoutPlan {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  exercises PlanExercise[]
  schedules ScheduleDay[]
  logs      WorkoutLog[]
}

model Exercise {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  nameKey     String
  tracking    String         @default("weight")
  createdAt   DateTime       @default(now())
  placements  PlanExercise[]
  entries     LogEntry[]

  @@unique([userId, nameKey])
  @@index([userId])
}

model PlanExercise {
  id          String      @id @default(cuid())
  planId      String
  plan        WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exerciseId  String?
  exercise    Exercise?   @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  name        String
  targetSets  Int
  restSeconds Int
  order       Int         @default(0)

  @@index([exerciseId])
}

model WeeklySchedule {
  id     String        @id @default(cuid())
  userId String        @unique
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  days   ScheduleDay[]
}

model ScheduleDay {
  id         String         @id @default(cuid())
  scheduleId String
  schedule   WeeklySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek  Int            // 0 = Zondag, 1 = Maandag ... 6 = Zaterdag
  planId     String?
  plan       WorkoutPlan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, dayOfWeek])
}

model WorkoutLog {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String?
  plan        WorkoutPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  entries     LogEntry[]
}

model LogEntry {
  id           String     @id @default(cuid())
  workoutLogId String
  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exerciseId   String?
  exercise     Exercise?  @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  exerciseName String
  setNumber    Int
  reps             Int
  weight           Float
  durationSeconds  Int?

  @@index([exerciseId])
}

model AppNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  dedupeKey String?
  createdAt DateTime @default(now())

  @@index([userId, dedupeKey])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model BodyWeightLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight   Float
  loggedAt DateTime @default(now())
}
